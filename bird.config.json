{
	"$schema": "./bird.config.schema.json",
	"theme": "dark",
	"downloads": {
		"autoOpenMaxSize": "1M",
		"autoOpenMimeTypes": [
			"image/*",
			"application/pdf",
			"video/*",
			"audio/*"
		],
		"preventDuplicateDownloads": true
	},
	"navBar": {
		"position": "bottom",
		"visible": true,
		"autoHide": true,
		"urlEditable": true,
		"showBackForward": true,
		"showReload": true
	},
	"apps": {
		"koreus": {
			"partition": "koreus",
			"startUrl": "https://www.koreus.com",
			"routing": {
				"internal": "https://www.koreus.com"
			},
			"navBar": {
				"position": "top"
			},
			"theme": "system",
			"icon": "koreus-360ac26c.png"
		},
		"gmail": {
			"partition": "gmail",
			"startUrl": "https://gmail.google.com",
			"routing": {
				"internal": "^https://[^/]*\\.google\\.com"
			}
		},
		"news": {
			"partition": "google",
			"startUrl": "https://news.google.com",
			"userAgent": "desktop:firefox:linux",
			"routing": {
				"internal": "^https://[^/]*\\.google\\.com"
			}
		},
		"test1": {
			"theme": "dark",
			"partition": "test",
			"startUrl": "https://the-internet.herokuapp.com/",
			"routing": {
				"internal": "https://the-internet.herokuapp.com"
			}
		},
		"test2": {
			"partition": "test",
			"startUrl": "https://testpages.herokuapp.com/styled/index.html",
			"routing": {
				"internal": "https://testpages.herokuapp.com"
			}
		}
	}
}