{
	"$ref": "#/definitions/BirdConfig",
	"definitions": {
		"BirdConfig": {
			"type": "object",
			"properties": {
				"theme": {
					"type": "string",
					"enum": [
						"system",
						"light",
						"dark"
					],
					"default": "system"
				},
				"navBar": {
					"type": "object",
					"properties": {
						"position": {
							"type": "string",
							"enum": [
								"top",
								"bottom"
							],
							"default": "top"
						},
						"visible": {
							"type": "boolean",
							"default": true
						},
						"autoHide": {
							"type": "boolean",
							"default": false
						},
						"urlEditable": {
							"type": "boolean",
							"default": true
						},
						"showBackForward": {
							"type": "boolean",
							"default": true
						},
						"showReload": {
							"type": "boolean",
							"default": true
						},
						"allowSingleTabClose": {
							"type": "boolean",
							"default": false
						}
					},
					"additionalProperties": false,
					"default": {}
				},
				"downloads": {
					"type": "object",
					"properties": {
						"directory": {
							"type": "string"
						},
						"autoOpenMaxSize": {
							"type": [
								"number",
								"string"
							]
						},
						"autoOpenMimeTypes": {
							"type": "array",
							"items": {
								"type": "string"
							}
						},
						"allowExecutablesDownload": {
							"type": "boolean"
						},
						"preventDuplicateDownloads": {
							"type": "boolean"
						}
					},
					"additionalProperties": false,
					"default": {}
				},
				"apps": {
					"type": "object",
					"additionalProperties": {
						"type": "object",
						"properties": {
							"partition": {
								"type": "string"
							},
							"startUrl": {
								"type": "string"
							},
							"theme": {
								"type": "string",
								"enum": [
									"system",
									"light",
									"dark"
								]
							},
							"userAgent": {
								"type": "string"
							},
							"userAgentRaw": {
								"type": "string"
							},
							"navBar": {
								"type": "object",
								"properties": {
									"position": {
										"type": "string",
										"enum": [
											"top",
											"bottom"
										],
										"default": "top"
									},
									"visible": {
										"type": "boolean",
										"default": true
									},
									"autoHide": {
										"type": "boolean",
										"default": false
									},
									"urlEditable": {
										"type": "boolean",
										"default": true
									},
									"showBackForward": {
										"type": "boolean",
										"default": true
									},
									"showReload": {
										"type": "boolean",
										"default": true
									},
									"allowSingleTabClose": {
										"type": "boolean",
										"default": false
									}
								},
								"additionalProperties": false
							},
							"routing": {
								"type": "object",
								"properties": {
									"internal": {
										"anyOf": [
											{
												"type": "string"
											},
											{
												"type": "array",
												"items": {
													"type": "string"
												}
											}
										]
									},
									"download": {
										"anyOf": [
											{
												"type": "string"
											},
											{
												"type": "array",
												"items": {
													"type": "string"
												}
											}
										]
									}
								},
								"additionalProperties": false
							}
						},
						"required": [
							"partition",
							"startUrl"
						],
						"additionalProperties": false
					},
					"default": {}
				}
			},
			"additionalProperties": false
		}
	},
	"$schema": "http://json-schema.org/draft-07/schema#"
}