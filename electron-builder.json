{
	"appId": "com.bird.app",
	"productName": "Bird",
	"publish": null,
	"directories": {
		"output": "release"
	},
	"afterPack": "./scripts/afterPack.cjs",
	"electronLanguages": ["ar", "de", "en-US", "es", "fr", "hi", "it", "pt-BR", "pt-PT", "ru", "zh-CN", "zh-TW"],
	"files": [
		"out/**/*",
		"package.json",
		"bird.config.schema.json",
		"!**/*.map",
		"!**/node_modules/**",
		"node_modules/@ghostery/adblocker-electron-preload/**",
		"node_modules/uiohook-napi/**",
		"node_modules/node-gyp-build/**"
	],
	"asarUnpack": ["**/*.node"],
	"extraResources": ["assets/icons/256x256.png"],
	"linux": {
		"target": ["AppImage", "deb"],
		"category": "Network",
		"icon": "assets/icons"
	},
	"win": {
		"target": [{ "target": "nsis", "arch": ["x64"] }],
		"icon": "assets/icons/icon.ico"
	},
	"nsis": {
		"oneClick": false,
		"allowToChangeInstallationDirectory": true,
		"packElevateHelper": false,
		"artifactName": "${productName}-${version}-${arch}-setup.${ext}",
		"include": "scripts/installer.nsh",
		"installerLanguages": ["en-US", "fr", "de", "es", "it", "pt-BR", "ru", "zh-CN"],
		"warningsAsErrors": false
	},
	"mac": {
		"target": ["dmg"],
		"icon": "assets/icons/icon.icns"
	}
}
