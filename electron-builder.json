{
	"appId": "com.bird.app",
	"productName": "Bird",
	"directories": {
		"output": "release"
	},
	"files": ["out/**/*", "package.json", "bird.config.schema.json"],
	"extraResources": ["assets/icons/256x256.png"],
	"linux": {
		"target": ["AppImage", "deb"],
		"category": "Network",
		"icon": "assets/icons"
	},
	"win": {
		"target": ["nsis", "portable"],
		"icon": "assets/icons/icon.ico"
	},
	"nsis": {
		"oneClick": false,
		"allowToChangeInstallationDirectory": true,
		"artifactName": "${productName}-${version}-${arch}-setup.${ext}"
	},
	"portable": {
		"artifactName": "${productName}-${version}-${arch}-portable.${ext}"
	},
	"mac": {
		"target": ["dmg"],
		"icon": "assets/icons/icon.icns"
	}
}
