{
	"appId": "com.bird.app",
	"productName": "Bird",
	"directories": {
		"output": "release"
	},
	"files": ["out/**/*", "package.json"],
	"extraResources": ["bird.config.schema.json"],
	"linux": {
		"target": ["AppImage", "deb"],
		"category": "Network",
		"icon": "assets/icons"
	},
	"win": {
		"target": ["nsis", "portable"],
		"icon": "assets/icons/icon.ico"
	},
	"mac": {
		"target": ["dmg"],
		"icon": "assets/icons/icon.icns"
	}
}
