{
	"$schema": "./abird.config.schema.json",
	"projectName": "bird_devel",
	"theme": "dark",
	"navBar": {
		"position": "bottom",
		"visible": true,
		"autoHide": false,
		"allowUrlEdit": true,
		"showBackButton": true,
		"showForwardButton": true,
		"showRefreshButton": true
	},
	"downloads": {
		"autoOpenMaxSize": "10M",
		"autoOpenMimeTypes": [
			"image/*",
			"application/pdf",
			"video/*",
			"audio/*"
		]
	},
	"apps": {
		"news": {
			"partition": "google",
			"startUrl": "https://news.google.com",
			"description": "pour avoir des newss",
			"icon": "news-53a6fe02.png",
			"userAgent": "desktop:firefox:linux",
			"routing": {
				"rules": {
					"^https?://([^/]+\\.)?google\\.com(/|$)": "internal"
				}
			},
			"downloads": {
				"autoOpenMimeTypes": [
					"application/msword",
					"application/vnd.ms-*",
					"application/vnd.openxmlformats-officedocument.*",
					"application/vnd.oasis.opendocument.*",
					"application/rtf",
					"application/pdf",
					"image/*",
					"video/*",
					"audio/*"
				]
			}
		},
		"test1": {
			"partition": "test",
			"startUrl": "https://the-internet.herokuapp.com/",
			"theme": "dark",
			"routing": {
				"rules": {
					"^https?://([^/]+\\.)?the-internet\\.herokuapp\\.com(/|$)": "internal",
					"^https?://([^/]+\\.)?herokuapp\\.com(/|$)": "internal"
				}
			},
			"downloads": {
				"autoOpenMimeTypes": [
					"application/msword",
					"application/vnd.ms-*",
					"application/vnd.openxmlformats-officedocument.*",
					"application/vnd.oasis.opendocument.*",
					"application/rtf",
					"application/pdf",
					"image/*",
					"video/*",
					"audio/*"
				]
			}
		},
		"test2": {
			"partition": "test",
			"startUrl": "https://testpages.herokuapp.com/styled/index.html",
			"routing": {
				"rules": {
					"^https?://([^/]+\\.)?testpages\\.herokuapp\\.com(/|$)": "internal"
				}
			}
		},
		"dark": {
			"partition": "test",
			"startUrl": "https://int10h.org/oldschool-pc-fonts/fontlist/font?ibm_vga_8x16#-",
			"routing": {
				"rules": {
					"^https?://([^/]+\\.)?int10h\\.org(/|$)": "internal"
				}
			}
		},
		"download": {
			"partition": "ovh",
			"startUrl": "https://proof.ovh.net/",
			"routing": {
				"rules": {
					"^https?://([^/]+\\.)?ovh\\.net(/|$)": "internal"
				}
			}
		}
	},
	"partitions": {}
}