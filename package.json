{
	"name": "bird",
	"version": "1.0.0",
	"description": "Web app wrapper - isolate web applications from the browser",
	"main": "out/main/index.js",
	"pnpm": {
		"onlyBuiltDependencies": ["@biomejs/biome", "electron", "esbuild"]
	},
	"scripts": {
		"dev": "electron-vite dev",
		"start:local": "electron-vite dev -- --config bird.config.json",
		"build": "electron-vite build",
		"preview": "electron-vite preview",
		"start": "electron .",
		"package": "pnpm run build && electron-builder",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "vitest",
		"test:run": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"keywords": ["electron", "webapp", "wrapper"],
	"author": "",
	"license": "ISC",
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^22.10.0",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.2",
		"electron": "^39.2.7",
		"electron-builder": "^26.0.12",
		"electron-vite": "^3.0.0",
		"knip": "^5.76.1",
		"typescript": "^5.9.3",
		"vite": "^6.0.0",
		"vitest": "^2.1.0"
	},
	"dependencies": {
		"lucide-react": "^0.562.0",
		"react": "^19.2.3",
		"react-dom": "^19.2.3"
	}
}
