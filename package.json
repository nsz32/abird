{
	"name": "bird",
	"version": "1.0.0",
	"description": "Web app wrapper - isolate web applications from the browser",
	"main": "out/main/index.js",
	"pnpm": {
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"electron",
			"esbuild"
		]
	},
	"scripts": {
		"dev": "electron-vite dev",
		"start:local": "electron-vite dev -- --config bird.config.json",
		"build": "electron-vite build",
		"build:standalone": "electron-vite build",
		"preview": "electron-vite preview",
		"start": "electron .",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "vitest",
		"test:run": "vitest run",
		"typecheck": "tsc --noEmit",
		"generate:schema": "npx tsx scripts/generate-schema.ts",
		"appimage": "electron-vite build && electron-builder --linux AppImage",
		"install:linux": "bash scripts/install-linux.sh"
	},
	"keywords": [
		"electron",
		"webapp",
		"wrapper"
	],
	"author": "",
	"license": "ISC",
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^22.10.0",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.2",
		"electron": "^39.2.7",
		"electron-builder": "^26.0.12",
		"electron-vite": "^3.0.0",
		"knip": "^5.76.1",
		"typescript": "^5.9.3",
		"vite": "^6.0.0",
		"vitest": "^2.1.0"
	},
	"dependencies": {
		"@chakra-ui/react": "^3.31.0",
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"electron-context-menu": "^4.1.1",
		"file-type": "^21.3.0",
		"framer-motion": "^12.26.2",
		"jimp": "^1.6.0",
		"lucide-react": "^0.562.0",
		"next-themes": "^0.4.6",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"react-icons": "^5.5.0",
		"uiohook-napi": "^1.5.4",
		"zod": "^3.25.76",
		"zod-to-json-schema": "^3.25.1"
	}
}
